# Required: identifies this service in DB/broker server-side logs and connection
# lists — every connector's appName when config.appName is unset. No default.
INSTANCE_NAME=my-service

# health() / circuit breaker (per link). Defaults shown; each is overridden per
# link by config.health.{attempts,timeout,threshold,cooldown}.
MAX_HEALTH_RETRIES=3
HEALTH_TIMEOUT_MS=2000
CIRCUIT_THRESHOLD=3
CIRCUIT_COOLDOWN_MS=30000
SQL_CLOSE_TIMEOUT_S=5

# Tests: see .env.test (docker-compose services). Overrides:
# POSTGRES_TEST_URL=postgres://tester:tester@localhost:55433/tester
# REDIS_HOST=localhost
# REDIS_PORT=56379
# MONGODB_TEST_URL=mongodb://localhost:57017/testdb
# REDPANDA_URL=localhost:59092
