# Identifies this service in DB/broker server-side logs and connection lists.
# Used as the default appName for every connector when config.appName is unset.
INSTANCE_NAME=connectors

# health() / circuit breaker (per connector). Defaults shown.
MAX_HEALTH_RETRIES=3
CIRCUIT_THRESHOLD=1
CIRCUIT_COOLDOWN_MS=30000
SQL_CLOSE_TIMEOUT_S=5

POSTGRES_TEST_URL=postgres://user:password@localhost:5432/testdb
REDIS_URL=redis://localhost:6379
REDPANDA_URL=localhost:19092
MONGO_URL=mongodb://localhost:6017
MONGODB_TEST_URL=mongodb://user:password@localhost:27017/testdb?authSource=admin
