# Loaded on top of .env when NODE_ENV=test (`bun run test`); points every test
# at the docker-compose services (`bun run docker:up`). Throwaway local
# credentials only — safe to commit.
POSTGRES_TEST_URL=postgres://tester:tester@localhost:55433/tester
REDIS_URL=redis://localhost:56379
MONGODB_TEST_URL=mongodb://localhost:57017/testdb
REDPANDA_URL=localhost:59092
