{
	"name": "@rniverse/connectors",
	"version": "0.0.1",
	"module": "index.ts",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./shared": {
			"types": "./dist/lib/shared/index.d.ts",
			"default": "./dist/lib/shared/index.js"
		},
		"./postgres": {
			"types": "./dist/lib/core/postgres/index.d.ts",
			"default": "./dist/lib/core/postgres/index.js"
		},
		"./redis": {
			"types": "./dist/lib/core/redis/index.d.ts",
			"default": "./dist/lib/core/redis/index.js"
		},
		"./mongo": {
			"types": "./dist/lib/core/mongo/index.d.ts",
			"default": "./dist/lib/core/mongo/index.js"
		},
		"./kafka": {
			"types": "./dist/lib/core/kafka/index.d.ts",
			"default": "./dist/lib/core/kafka/index.js"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"lint": "biome check --write",
		"test": "NODE_ENV=test bun test",
		"docker:up": "docker compose up -d --wait",
		"docker:down": "docker compose down -v",
		"build": "bun run tsc --project tsconfig.build.json && bun run tsc-alias --project tsconfig.build.json",
		"biome": "biome",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:push": "drizzle-kit push",
		"db:introspect": "drizzle-kit introspect",
		"db:studio": "drizzle-kit studio"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.12",
		"@types/bun": "^1.4.0",
		"drizzle-kit": "^0.31.10",
		"tsc-alias": "^1.9.4"
	},
	"peerDependencies": {
		"@rniverse/utils": "github:rniverse/utils#dist",
		"@valkey/valkey-glide": "^2.5.2",
		"drizzle-orm": "^0.45.2",
		"kafkajs": "^2.2.4",
		"mongodb": "^7.6.0",
		"postgres": "^3.4.9",
		"typescript": "^7.0.2"
	},
	"private": true,
	"type": "module",
	"dependencies": {}
}
